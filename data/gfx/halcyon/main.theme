message "Kobo Redux Halcyon Graphics Theme"
message "Copyright 2026 Andrew Ahlfield"
message "CC BY-SA 4.0 (http://creativecommons.org/licenses/by-sa/4.0/)"

//-----------------------------------------------------------------------------
// Every image in this theme is generated by tools/art (see its README).
// Edit the generator, not the PNG files, and rerun:
//	cd tools/art && python3 -m halcyon.build
//
// The theme is complete; it does not need the Mono theme as a fallback.
//-----------------------------------------------------------------------------


//-----------------------------------------------------------------------------
message "Defining dashboard layout"
//-----------------------------------------------------------------------------

// set THEMEDATA x y w h <rel>

set D_DASH_MAIN		132	4	352	352
set D_DASH_TOPLEDS	136	2	344	2
set D_DASH_BOTTOMLEDS	136	356	344	2
set D_DASH_LEFTLEDS	130	8	2	344
set D_DASH_RIGHTLEDS	484	8	2	344

set D_DASH_CONSOLE	8	52	104	256
set D_DASH_CHARGE	118	80	12	200
set D_DASH_HEALTH	486	80	12	200
set D_DASH_RADAR	504	52	128	256

set D_DASH_HIGH		0	8	104	18	D_DASH_CONSOLE
set D_DASH_SCORE	0	32	104	18	D_DASH_CONSOLE
set D_DASH_WSLOT1	0	75	52	52	D_DASH_CONSOLE
set D_DASH_WSLOT2	52	75	52	52	D_DASH_CONSOLE
set D_DASH_WSLOT3	0	129	52	52	D_DASH_CONSOLE
set D_DASH_WSLOT4	52	129	52	52	D_DASH_CONSOLE
set D_DASH_REGION	0	206	104	18	D_DASH_CONSOLE
set D_DASH_LEVEL	0	230	104	18	D_DASH_CONSOLE


//-----------------------------------------------------------------------------
message "Loading in-game graphics"
//-----------------------------------------------------------------------------

// Master palette (64 colours; see halcyon.gpl)
path ""
palette P_MAIN "halcyon.gpl"
palette P_MAIN_STARS P_MAIN 3 5 6 7

// Explosion ("fire") palettes, dark to bright. The engine adds a transparent
// entry before the first colour. Every palette starts in warm smoke so
// blasts roll into smoke as they cool. Levels alternate between hot orange
// blasts and plasma, magenta and toxic tints so stages feel distinct.
palette P_FIRE_L1 P_MAIN 0 40 41 42 33 34 35 36 37 38 39
palette P_FIRE_L2 P_FIRE_L1
palette P_FIRE_L3 P_MAIN 0 40 41 46 47 48 49 50 51 8
palette P_FIRE_L4 P_FIRE_L1
palette P_FIRE_L5 P_MAIN 0 40 41 58 59 60 61 62 63 8
palette P_FIRE_L6 P_FIRE_L1
palette P_FIRE_L7 P_MAIN 0 40 41 52 53 54 55 56 57 8
palette P_FIRE_L8 P_FIRE_L1
palette P_FIRE_L9 P_FIRE_L3
palette P_FIRE_L10 P_MAIN 0 40 41 42 43 32 33 34 35 36 37 38 39 39

// Particle effects
particles PFX_PIPEOUT {
	default
	count	48
	radius	2	3	0	1	0
	speed	3	5	0	1	0
	heat	1.2	1.6	.6	1	0
	fade	.86	.88	.8	1	0
}
alias PFX_PIPEIN PFX_PIPEOUT

particles PFX_ENEMY1 {
	default
	count	180
	radius	3	5	0	1	0
	speed	2.5	4	0	1	0
	heat	1.5	2.5	.7	1	0
}
alias PFX_ENEMY2 PFX_ENEMY1
alias PFX_ENEMY3 PFX_ENEMY1
alias PFX_ENEMY4 PFX_ENEMY1
alias PFX_ENEMY5 PFX_ENEMY1
alias PFX_ENEMY6 PFX_ENEMY1
alias PFX_ENEMY7 PFX_ENEMY1
alias PFX_BOMB1 PFX_ENEMY1
alias PFX_BOMB2 PFX_ENEMY1

particles PFX_PLAYER_DEATH {
	default
	count	900
	radius	12	18	0	1	0
	twist	0	0	1	1	0
	speed	4	7	0	1	0
	drag	.92	.94	1	1	0
	heat	2	2.5	.5	1	0
	fade	.965	.975	1	1	0
	chain {
		count 40
		radius	36	44	0	1	0
		child {
			default
			count	96
			delay	8	90
		}
	}
}

particles PFX_CANNON {
	default
	count	360
	radius	5	10	0	1	0
	speed	4	6	0	1	0
	heat	1.8	2.6	.6	1	0
}

particles PFX_CORE {
	count	12
	radius	10	12	0	1	0
	speed	9	11	0	1	0
	child {
		default
		count	110
		radius	1	2	0	1	0
	}
	chain {
		default
		count	480
		heat	2	3	.6	1	0
	}
}
alias PFX_ENEMY_M1 PFX_CORE
alias PFX_ENEMY_M2 PFX_CORE
alias PFX_ENEMY_M3 PFX_CORE
alias PFX_ENEMY_M4 PFX_CORE

particles PFX_CORE_FIRE {
	default
	count	20
	radius	2	2	0	1	0
	speed	1	1.4	0	1	0
	drag	.9	.9	1	1	0
	heat	1	1.2	1	1	0
	fade	.8	.82	1	1	0
}

particles PFX_BOMB1DETO {
	default
	count	110
	radius	3	3	0	1	0
	speed	3	3.5	0	1	0
	drag	.9	.9	1	1	0
	fade	.9	.9	.7	1	0
}

particles PFX_BOMB2DETO {
	default
	count	150
	radius	5	5	0	1	0
	speed	5	5.5	0	1	0
	drag	.9	.9	1	1	0
	fade	.9	.9	.7	1	0
}

particles PFX_CHARGED_BLAST {
	default
	count	64
	radius	1	2	0	1	0
	speed	1	2	0	1	0
	heat	.8	1	.6	1	0
	fade	.8	.84	.8	1	0
}

// Spinning planet palettes (only used by the dithered planet modes; the
// default RAW mode shows the texture colours directly)
palette P_PLANET_R1 P_MAIN 0 1 2 3 4 5 6 7
palette P_PLANET_R2 P_MAIN 0 14 25 26 27 28 19 20
palette P_PLANET_R3 P_MAIN 0 9 29 10 30 11 31 13
palette P_PLANET_R4 P_MAIN 0 14 21 15 22 23 24 8
palette P_PLANET_R5 P_MAIN 0 2 3 5 6 7 13 8

// Title logo effect
set D_LOGO_EFFECT LOGO_FX_SLIDE

// Rendering parameters
set D_BACKDROP_COLORMOD .8
set D_PLANET_DITHERMODE RAW
set D_PLANET_COLORMOD .6
set D_PLANET_BRIGHTNESS	-24 -20 -16 -12 -8 -4 0
set D_PLANET_CONTRAST	-40 -36 -32 -28 -24 -20 -16
set D_BASES_COLORMOD	.45 .7 1 .55	// far/near/current/current_title
set D_FIRE_DITHERMODE ORDERED

// Radar: KOBO_RC_(BACKGROUND BASE NODE CORE   PLAYER[0..7])
palette P_RADAR P_MAIN 0 4 11 18   8 13 12 11 10 9 2 1

// Space backdrop
path ""
image B_SPACE "space.png"

// Regions. Each region of ten stages has its own base tile set, planet and
// surface textures.
path "region-1"
sprites B_R1_TILES "tiles.png" 16 16
sprites B_R1_TILES_SMALL_SPACE "tiles-small.png" 12 12
sprites B_R1_TILES_TINY_SPACE "tiles-tiny.png" 8 8
alias B_R1_TILES_TINY_INTERMEDIATE B_R1_TILES_TINY_SPACE
alias B_R1_TILES_SMALL_GROUND B_R1_TILES_SMALL_SPACE
alias B_R1_TILES_TINY_GROUND B_R1_TILES_TINY_SPACE
image B_R1_PLANET "planet.png"
image B_R1L8_GROUND "ground-l8.png"
alias B_R1L9_GROUND B_R1_PLANET
image B_R1L10_GROUND "ground-l10.png"

path "region-2"
sprites B_R2_TILES "tiles.png" 16 16
sprites B_R2_TILES_SMALL_SPACE "tiles-small.png" 12 12
sprites B_R2_TILES_TINY_SPACE "tiles-tiny.png" 8 8
alias B_R2_TILES_TINY_INTERMEDIATE B_R2_TILES_TINY_SPACE
alias B_R2_TILES_SMALL_GROUND B_R2_TILES_SMALL_SPACE
alias B_R2_TILES_TINY_GROUND B_R2_TILES_TINY_SPACE
image B_R2_PLANET "planet.png"
image B_R2L8_GROUND "ground-l8.png"
alias B_R2L9_GROUND B_R2_PLANET
image B_R2L10_GROUND "ground-l10.png"

path "region-3"
sprites B_R3_TILES "tiles.png" 16 16
sprites B_R3_TILES_SMALL_SPACE "tiles-small.png" 12 12
sprites B_R3_TILES_TINY_SPACE "tiles-tiny.png" 8 8
alias B_R3_TILES_TINY_INTERMEDIATE B_R3_TILES_TINY_SPACE
alias B_R3_TILES_SMALL_GROUND B_R3_TILES_SMALL_SPACE
alias B_R3_TILES_TINY_GROUND B_R3_TILES_TINY_SPACE
image B_R3_PLANET "planet.png"
image B_R3L8_GROUND "ground-l8.png"
alias B_R3L9_GROUND B_R3_PLANET
image B_R3L10_GROUND "ground-l10.png"

path "region-4"
sprites B_R4_TILES "tiles.png" 16 16
sprites B_R4_TILES_SMALL_SPACE "tiles-small.png" 12 12
sprites B_R4_TILES_TINY_SPACE "tiles-tiny.png" 8 8
alias B_R4_TILES_TINY_INTERMEDIATE B_R4_TILES_TINY_SPACE
alias B_R4_TILES_SMALL_GROUND B_R4_TILES_SMALL_SPACE
alias B_R4_TILES_TINY_GROUND B_R4_TILES_TINY_SPACE
image B_R4_PLANET "planet.png"
image B_R4L8_GROUND "ground-l8.png"
alias B_R4L9_GROUND B_R4_PLANET
image B_R4L10_GROUND "ground-l10.png"

path "region-5"
sprites B_R5_TILES "tiles.png" 16 16
sprites B_R5_TILES_SMALL_SPACE "tiles-small.png" 12 12
sprites B_R5_TILES_TINY_SPACE "tiles-tiny.png" 8 8
alias B_R5_TILES_TINY_INTERMEDIATE B_R5_TILES_TINY_SPACE
alias B_R5_TILES_SMALL_GROUND B_R5_TILES_SMALL_SPACE
alias B_R5_TILES_TINY_GROUND B_R5_TILES_TINY_SPACE
image B_R5_PLANET "planet.png"
image B_R5L8_GROUND "ground-l8.png"
alias B_R5L9_GROUND B_R5_PLANET
image B_R5L10_GROUND "ground-l10.png"

path "sprites"
sprites B_PLAYER "player.png" 24 24 CENTER
sprites B_BMR_GREEN "crescent-green.png" 24 24 CENTER
sprites B_BMR_PURPLE "crescent-violet.png" 24 24 CENTER
sprites B_BMR_PINK "crescent-rose.png" 24 24 CENTER
sprites B_FIGHTER "fighter.png" 24 24 CENTER
sprites B_MISSILE1 "missile1.png" 16 16 CENTER
sprites B_MISSILE2 "missile2.png" 16 16 CENTER
sprites B_MISSILE3 "missile3.png" 16 16 CENTER
sprites B_BOLT "bolt.png" 8 8 CENTER
sprites B_ROCK1 "rock.png" 32 32 CENTER
alias B_ROCK2 B_ROCK1
alias B_ROCK3 B_ROCK1
sprites B_ROCKEXPL "rockexpl.png" 64 64 CENTER
sprites B_BLT_GREEN "bullet-green.png" 6 6 CENTER
sprites B_BLT_RED "bullet-red.png" 6 6 CENTER
sprites B_BLT_BLUE "bullet-blue.png" 6 6 CENTER
sprites B_BLTX_GREEN "bulletexpl-green.png" 16 16 CENTER
sprites B_BLTX_RED "bulletexpl-red.png" 16 16 CENTER
sprites B_BLTX_BLUE "bulletexpl-blue.png" 16 16 CENTER
sprites B_RING "ring.png" 16 16 CENTER
sprites B_RINGEXPL "ringexpl.png" 20 20 CENTER
sprites B_BOMB "bomb.png" 12 12 CENTER
sprites B_BOMBDETO "bombdeto.png" 20 20 CENTER
sprites B_BIGSHIP "mothership.png" 48 48 CENTER


//-----------------------------------------------------------------------------
message "Loading dashboard graphics"
//-----------------------------------------------------------------------------

path "dashboard"
image B_SCREEN "dashboard.png"
sprites B_CROSSHAIR "crosshair.png" 16 16 1 CENTER
sprites B_TOPLEDS "leds-h.png" 8 2
alias B_BOTTOMLEDS B_TOPLEDS
sprites B_LEFTLEDS "leds-v.png" 2 8
alias B_RIGHTLEDS B_LEFTLEDS
sprites B_HEALTHLEDS "shieldleds.png" 12 4
sprites B_CHARGELEDS "chargeleds.png" 12 4
sprites B_WEAPONSLOTS "weaponslots.png" 52 52
sprites B_WEAPONS "weapons.png" 40 40
sprites B_LOGO "logo.png" 320 128


//-----------------------------------------------------------------------------
message "Loading fonts"
//-----------------------------------------------------------------------------

path "fonts"
sfont B_SMALL_FONT "microfont.png"
sfont B_NORMAL_FONT "smallfont.png"
alias B_MEDIUM_FONT B_NORMAL_FONT
sfont B_BIG_FONT "bigfont.png"
sfont B_COUNTER_FONT "counterfont.png"


//-----------------------------------------------------------------------------
message "Loading special FX graphics"
//-----------------------------------------------------------------------------

path "fx"
sprites B_NOISE "noise.png" 256 1
sprites B_HITNOISE "hitnoise.png" 256 1
sprites B_SHIELDFX "shield.png" 32 32 CENTER

// Fullscreen grid transition effect
set D_FS_GRIDTFXLEVELS	32
set D_FS_GRIDTFX_SLOW	2.5
set D_FS_GRIDTFX_FAST	1
sprites B_FS_GRIDTFXTILES "fs-gridtfx-tiles.png" 40 40

// Grid transition effect for dashboard windows
set D_GRIDTFXLEVELS	16
sprites B_GRIDTFXTILES "gridtfx-tiles.png" 16 16
set D_GRIDTFX_COLORMOD	1 .5	// front/below

// Menu focus fire effect
set D_FOCUSFX_DITHERMODE NOISE
palette P_FOCUSFX P_MAIN 1 10 11 12 13 13 8
