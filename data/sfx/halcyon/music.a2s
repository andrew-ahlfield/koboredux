export S_EPILOGUE()
{
	struct {
		inline 0 2
		fbdelay 2 2
		panmix 2 >
	}
	fbdelay 610; fbgain 0.45
	ldelay 410; lgain 0.40
	rdelay 820; rgain 0.40
	vol .45
	set
	1:HEpilogue
	end
.stop	vol 0; d 1000
	kill 1
	1() {
		force stop
	}
}
