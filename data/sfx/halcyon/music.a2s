export S_INGAMESONG1()
{
	struct {
		inline 0 2
		fbdelay 2 2
		panmix 2 >
	}
	fbdelay 380; fbgain 0.35
	ldelay 285; lgain 0.30
	rdelay 427; rgain 0.30
	vol .45
	set
	1:HRegion1
	end
.stop	vol 0; d 1000
	kill 1
	1() {
		force stop
	}
}


