export S_TITLESONG()
{
	struct {
		inline 0 2
		fbdelay 2 2
		panmix 2 >
	}
	fbdelay 530; fbgain 0.40
	ldelay 357; lgain 0.35
	rdelay 714; rgain 0.35
	vol .45
	set
	1:HTitle
	end
.stop	vol 0; d 1000
	kill 1
	1() {
		force stop
	}
}


